# Copy to .env. `shield dev init` fills the empty secrets with random values. Never commit .env.

# seed: the official synthetic dump (734 rows, 29 columns). Not committed to this repo.
SEED_DUMP=../hackathon_dprri-main/anggota_dummy.sql

# portable binaries (Windows dev machine); in Docker the services come from their own images
MARIADB_HOME=../benteng-platform/.tools/mariadb
PG_HOME=../hackathon_dprri-main/.tools/pg16/pgsql

# fixture databases, ports fixed by the shared contract
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
PG_PORT=5432
PG_SUPER_PASSWORD=

# key service (separate process / container, internal only)
KMS_URL=http://127.0.0.1:8200
KMS_TOKEN=

# where Shield records the demo mode the websites read (MODE=vuln|hardened)
MODE_FILE=out/MODE
